    {
      "id": "telescot",
      "title": "Supported Telemonitoring and Glycemic Control in People with Type 2 Diabetes: The Telescot Diabetes Pragmatic Multicenter Randomized Controlled Trial",
      "authors": [
        "Wild SH",
        "Hanley J",
        "Lewis SC",
        "McKnight JA",
        "McCloughan LB",
        "Padfield PL",
        "Parker RA",
        "Paterson M",
