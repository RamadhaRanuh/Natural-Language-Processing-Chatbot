      "passages": [
        {
          "id": "st2ep-population",
          "text": "We conducted an open-label randomised controlled trial. A total of 151 adults (76% women, mean age 52.5) with type 2 diabetes (HbA1c≥8%), treated in the diabetes consultation units of two secondary health centres in Bamako, were allocated to peer-led structured patient education (n = 76) or conventional care alone (n = 75).",
          "locator": "./front/article-meta/abstract/sec[2]/p"
        },
        {
          "id": "st2ep-results",
          "text": "As shown in Table 2, the reduction in HbA1c levels between baseline and 12 months was higher (p = 0.006) in the intervention group (-1.05 [sd = 2.0]) than in the control group (-0.15 [sd = 1.7]). The effect size was 0.48 (CI95%: 0.14–0.81).",
          "locator": "./body/sec[@id='sec016']/p[2]"
        },
        {
          "id": "st2ep-table",
          "text": "HbA1c, % | -1.05 (-1.54; -0.56) | -0.15 (-0.56; 0.26) | 0.006",
          "locator": ".//table-wrap[@id='pone.0191262.t002']/table/tbody/tr[5]"
        },
        {
          "id": "st2ep-denominators",
          "text": " | Intervention group(n = 70) | Control group(n = 70) | p-value",
          "locator": ".//table-wrap[@id='pone.0191262.t002']/table/thead/tr"
