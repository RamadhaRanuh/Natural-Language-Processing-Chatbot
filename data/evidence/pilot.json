        "McKinstry B"
      ],
      "year": 2016,
      "doi": "10.1371/journal.pmed.1002098",
      "pmid": "27458809",
      "pmcid": "PMC4961438",
      "url": "https://doi.org/10.1371/journal.pmed.1002098",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "license": "CC BY 4.0",
      "document_hash": "c95c940287c2f98210fdb976e5eb99de58d0d66676487c7139ee7b16c8c78e5b",
      "kind": "paper",
      "population": "UK adults with poorly controlled type 2 diabetes.",
      "design": "Randomized supported telemonitoring versus usual care.",
      "limitations": [
        "Clinician-supported intervention; this trial did not test an autonomous chatbot.",
        "Representativeness and long-term persistence are uncertain.",
        "Declared correction replaces adverse-events supplement; inspect corrected supplement before harm claims.",
        "Table 5 and abstract/body report different p-values; p-values omitted pending review.",
        "No medical or Indonesian-language reviewer has approved this fixture."
      ],
      "passages": [
        {
          "id": "telescot-population",
          "text": "We performed a randomized, parallel, investigator-blind controlled trial with centralized randomization in family practices in four regions of the United Kingdom among 321 people with type 2 diabetes and glycated hemoglobin (HbA1c) >58 mmol/mol.",
          "locator": "./front/article-meta/abstract/sec[2]/p"
        },
        {
          "id": "telescot-followup",
          "text": "HbA1c assessed at 9 mo was the primary outcome.",
          "locator": "./front/article-meta/abstract/sec[2]/p"
        },
        {
          "id": "telescot-denominators",
          "text": "HbA1c data at follow-up were available for 146 people in the intervention group and 139 people in the control group.",
          "locator": "./front/article-meta/abstract/sec[2]/p"
        },
        {
          "id": "telescot-result",
          "text": "adjusted mean HbA1c was 5.60 mmol/mol / 0.51% lower (95% CI 2.38 to 8.81 mmol/mol/ 95% CI 0.22% to 0.81%, p = 0·0007).",
          "locator": "./front/article-meta/abstract/sec[2]/p"
        },
        {
          "id": "telescot-conclusion",
          "text": "Supported telemonitoring resulted in clinically important improvements in control of glycaemia in patients with type 2 diabetes in family practice.",
          "locator": "./front/article-meta/abstract/sec[3]/p"
        }
      ],
      "claims": [
        {
          "id": "telescot-monitoring-outcome",
